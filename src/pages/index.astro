---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const catalogoEntry = await getEntry('productos', 'catalogo');
const allProducts = catalogoEntry ? catalogoEntry.data.catalogo : [];

// Agrupar por categoría
const productsByCategory = allProducts.reduce((acc, product) => {
  const cat = product.categoria || 'Otros';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(product);
  return acc;
}, {} as Record<string, typeof allProducts>);

const categories = Object.keys(productsByCategory);
---

<Layout title="Paletería Princesa | Sabor Tradicional">
  <!-- Hero Section -->
  <div class="relative bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="relative z-10 pb-8 bg-white sm:pb-16 md:pb-20 lg:max-w-2xl lg:w-full lg:pb-28 xl:pb-32 pt-20">
        <svg class="hidden lg:block absolute right-0 inset-y-0 h-full w-48 text-white transform translate-x-1/2" fill="currentColor" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <polygon points="50,0 100,0 50,100 0,100" />
        </svg>

        <main class="mt-10 mx-auto max-w-7xl px-4 sm:mt-12 sm:px-6 md:mt-16 lg:mt-20 lg:px-8 xl:mt-28">
          <div class="sm:text-center lg:text-left">
            <h1 class="text-4xl tracking-tight font-extrabold text-gray-900 sm:text-5xl md:text-6xl">
              <span class="block xl:inline">Dale a tu paladar</span>{' '}
              <span class="block text-blue-600 xl:inline">un gusto especial</span>
            </h1>
            <p class="mt-3 text-base text-gray-500 sm:mt-5 sm:text-lg sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0">
              Disfruta de la mejor calidad en paletas, nieves y bolis. Precios especiales de mayoreo ideales para tus eventos o negocio.
            </p>
            <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start">
              <div class="rounded-md shadow">
                <a href="#catalogo" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-800 md:py-4 md:text-lg md:px-10 transition-colors">
                  Ver Catálogo
                </a>
              </div>
              <div class="mt-3 sm:mt-0 sm:ml-3">
                <a href="#politica" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-blue-700 bg-yellow-100 hover:bg-yellow-200 md:py-4 md:text-lg md:px-10 transition-colors">
                  Precios
                </a>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
    <div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
      <img class="h-56 w-full object-cover sm:h-72 md:h-96 lg:w-full lg:h-full" src="img/logo/logo.png" alt="Paletas de hielo coloridas" />
    </div>
  </div>

  <!-- Pricing Policy Banner -->
  <div id="politica" class="bg-gradient-to-r from-yellow-500 to-blue-600 transform -skew-y-1 my-12 py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 transform skew-y-1">
        <div class="text-center">
            <h2 class="text-3xl font-extrabold text-white sm:text-4xl mb-6">
                ¡Gana más comprando más!
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-white">
                <div class="bg-white/10 backdrop-blur-lg rounded-xl p-6 border border-white/20">
                    <div class="text-2xl font-bold mb-2">Menudeo</div>
                    <p class="opacity-90">1 a 29 piezas</p>
                    <p class="text-sm mt-2 font-light">Precio regular para un antojo.</p>
                </div>
                <div class="bg-white/10 backdrop-blur-lg rounded-xl p-6 border border-white/20 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-yellow-400 text-yellow-900 text-xs font-bold px-2 py-1 transform rotate-0 rounded-bl-lg">POPULAR</div>
                    <div class="text-2xl font-bold mb-2">Medio Mayoreo</div>
                    <p class="opacity-90">30 a 49 piezas</p>
                    <p class="text-sm mt-2 font-light">Ideal para reuniones pequeñas.</p>
                </div>
                <div class="bg-white/20 backdrop-blur-lg rounded-xl p-6 border border-white/40 shadow-xl scale-105">
                    <div class="text-2xl font-bold mb-2">Mayoreo</div>
                    <p class="opacity-90">50+ piezas</p>
                    <p class="text-sm mt-2 font-light">¡El mejor precio para tu negocio!</p>
                </div>
            </div>
  </div>
      </div>
  </div>

  <!-- Catalog Section -->
  <div id="catalogo" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="text-center mb-16">
        <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
            Nuestro Catálogo
        </h2>
        <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">
            Explora nuestra variedad de sabores y presentaciones.
        </p>
    </div>

    {categories.map(category => (
      <section class="mb-20">
        <div class="flex items-center mb-8">
            <h3 class="text-2xl font-bold text-gray-800 pr-4">{category}</h3>
            <div class="flex-grow h-px bg-gray-200"></div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
          {productsByCategory[category].map(product => (
            <ProductCard product={product} />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
