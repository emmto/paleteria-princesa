---
import type { CollectionEntry } from 'astro:content';
import AddToCart from './AddToCart';
import { formatCardPrice } from '../utils/cartLogic';

interface Props {
  product: CollectionEntry<'productos'>['data']['catalogo'][number];
}

const { product } = Astro.props;

const getCategoryColor = (cat: string) => {
  switch (cat) {
    case 'Paletas':
      return 'bg-green-100 text-green-700';
    case 'Paletas Premium':
      return 'bg-emerald-100 text-emerald-700';
    case 'Nieves':
      return 'bg-blue-100 text-blue-700';
    case 'Bolis':
      return 'bg-yellow-100 text-yellow-700';
    default:
      return 'bg-purple-100 text-purple-700';
  }
};

const categoryColor = getCategoryColor(product.categoria || '');
const imageSrc = product.imagen
  ? product.imagen
  : `https://placehold.co/400x300/f3f4f6/db2777?text=${encodeURIComponent(product.nombre)}`;
---

<div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full overflow-hidden border border-gray-100">
  <!-- Image Area -->
  <div class="relative h-44 sm:h-48 overflow-hidden bg-gray-100">
    <img
      src={imageSrc}
      alt={product.nombre}
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    {product.categoria && (
      <div class="absolute top-3 left-3">
        <span class={`text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider ${categoryColor}`}>
          {product.categoria}
        </span>
      </div>
    )}
  </div>

  <!-- Content Area -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col">
    <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-3 leading-tight group-hover:text-blue-600 transition-colors">
      {product.nombre}
    </h3>

    <!-- Prices Grid -->
    <div class="grid grid-cols-3 gap-1.5 sm:gap-2 mb-4 mt-auto">
      <div class="text-center p-2 rounded-lg bg-gray-50 group-hover:bg-green-50 transition-colors">
        <span class="block text-[10px] uppercase text-gray-500 font-bold">1-29 pz</span>
        <span class="block font-bold text-gray-900 text-base sm:text-lg">
          {formatCardPrice(product.precios.menudeo)}
        </span>
      </div>
      <div class="text-center p-2 rounded-lg bg-gray-50 group-hover:bg-blue-50 transition-colors">
        <span class="block text-[10px] uppercase text-gray-500 font-bold">30-49</span>
        <span class="block font-bold text-blue-600 text-base sm:text-lg">
          {formatCardPrice(product.precios.medio)}
        </span>
      </div>
      <div class="text-center p-2 rounded-lg bg-gray-50 group-hover:bg-pink-50 transition-colors">
        <span class="block text-[10px] uppercase text-gray-500 font-bold">50+</span>
        <span class="block font-bold text-pink-600 text-base sm:text-lg">
          {formatCardPrice(product.precios.mayoreo)}
        </span>
      </div>
    </div>

    <div>
      {product.permiteVariado && product.sabores && (
        <p class="text-xs text-center text-gray-400 mb-1.5 italic">
          * Escoge sabor(es) en el carrito
        </p>
      )}
      <AddToCart client:visible product={product} />
    </div>
  </div>
</div>
