---
import type { CollectionEntry } from 'astro:content';
import AddToCart from './AddToCart';

interface Props {
  product: CollectionEntry<'productos'>['data'];
}

const { product } = Astro.props;

// Helper to get a color based on category for the placeholder
const getCategoryColor = (cat: string) => {
    switch(cat) {
        case 'Paletas': return 'bg-green-100 text-green-600';
        case 'Nieves': return 'bg-blue-100 text-blue-600';
        case 'Bolis': return 'bg-yellow-100 text-yellow-600';
        default: return 'bg-purple-100 text-purple-600';
    }
};

const categoryColor = getCategoryColor(product.categoria || '');
// Si el JSON tiene imagen, úsala. Si no, usa el placeholder.
const imageSrc = product.imagen 
  ? product.imagen 
  : `https://placehold.co/400x300/f3f4f6/db2777?text=${encodeURIComponent(product.nombre)}`;
---

<div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full overflow-hidden border border-gray-100">
  <!-- Image Area -->
  <div class="relative h-48 overflow-hidden bg-gray-100">
    <img 
        src={imageSrc} 
        alt={product.nombre}
        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
        loading="lazy"
    />
    <div class="absolute top-3 left-3">
        <span class={`text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider ${categoryColor}`}>
            {product.categoria}
        </span>
    </div>
  </div>

  <!-- Content Area -->
  <div class="p-5 flex-1 flex flex-col">
    <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight group-hover:text-blue-600 transition-colors">
        {product.nombre}
    </h3>
    
    <!-- Prices Grid -->
    <div class="grid grid-cols-3 gap-2 mb-6 mt-auto">
        <div class="text-center p-2 rounded-lg bg-gray-50 group-hover:bg-green-50 transition-colors">
            <span class="block text-[10px] uppercase text-gray-500 font-bold">1-29 pz</span>
            <span class="block font-bold text-gray-900 text-lg">${product.precios.menudeo}</span>
        </div>
        <div class="text-center p-2 rounded-lg bg-gray-50 group-hover:bg-green-50 transition-colors">
            <span class="block text-[10px] uppercase text-gray-500 font-bold">30-49</span>
            <span class="block font-bold text-blue-600 text-lg">${product.precios.medio}</span>
        </div>
        <div class="text-center p-2 rounded-lg bg-gray-50 group-hover:bg-green-50 transition-colors">
            <span class="block text-[10px] uppercase text-gray-500 font-bold">50+</span>
            <span class="block font-bold text-pink-600 text-lg">${product.precios.mayoreo}</span>
        </div>
    </div>

    <div class="mt-2">
        {product.permiteVariado && product.sabores && (
            <p class="text-[14px] text-center text-gray-400 mt-1 italic">
                * Escoge sabor(es) en el carrito
            </p>
        )}
        <AddToCart client:visible product={product} />
    </div>
  </div>
</div>