---
import '../styles/global.css';
import Header from '../components/Header';
import ShoppingCart from '../components/ShoppingCart';
import ToastNotification from '../components/ToastNotification';
import MobileCartBar from '../components/MobileCartBar';
import WhatsAppFloat from '../components/WhatsAppFloat';

interface Props {
  title?: string;
}

const { title = "Helados la Princesa | Calidad y Tradición" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Helados la Princesa en Tepic, Nayarit. Paletas, nieves, bolis y especialidades con precios de menudeo, medio mayoreo y mayoreo." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Disfruta de la mejor calidad en paletas, nieves y bolis. Precios especiales de mayoreo ideales para tus eventos o negocio." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/img/logo/logo.png" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased selection:bg-pink-100 selection:text-pink-900">
    <Header client:load />
    <ShoppingCart client:idle />
    <MobileCartBar client:idle />
    <WhatsAppFloat client:idle />
    <ToastNotification client:idle />

    <main>
      <slot />
    </main>

    <footer id="nosotros" class="scroll-mt-20 bg-gray-900 text-white pt-12 pb-28 md:pb-12 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-xl font-bold italic mb-4 text-yellow-500">Helados la Princesa</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Empresa Nayarita especializada en la elaboración, fabricación y venta de productos helados con los más altos niveles de control de calidad.
            </p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-4">Contacto</h4>
            <p class="text-gray-400 text-sm mb-2">📞 52 000 0000</p>
            <p class="text-gray-400 text-sm">📍 Tepic, Nayarit</p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-4">Horario</h4>
            <p class="text-gray-400 text-sm">Lunes a Sábado</p>
            <p class="text-gray-400 text-sm">8:00 AM - 1:00 PM</p>
            <p class="text-gray-400 text-sm">3:00 PM - 6:00 PM</p>
          </div>
        </div>
        <div class="border-t border-gray-800 mt-12 pt-8 text-center text-sm text-gray-500">
          <p>&copy; {new Date().getFullYear()} Helados la Princesa. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
